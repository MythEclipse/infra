# ── Caddyfile PRODUKSI v2 — TUNED (auto-TLS Let's Encrypt) ──
# Tuning: HTTP/3 default, keep-alive upstream, zstd+gzip, timeouts, buffer, TLS 1.3
# NOTE: file ini adalah source of truth untuk /etc/caddy/Caddyfile di orangevps.
#       Changes di-deploy otomatis via .github/workflows/caddy-deploy.yml
#       (push ke main → ssh → cp → systemctl reload caddy).

{
	email asepharyana@gmail.com

	# Global tuning
	servers {
		protocols h1 h2 h3
		trusted_proxies static private_ranges
	}
	grace_period 10s
}

# ── Helper: handler umum (gzip + zstd, header keamanan) — dipanggil dgn argumen: port
# Penggunaan: import proxy 4003
(proxy) {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	# Keep-alive upstream: max 100 idle conns per host, dial timeout 3s
	reverse_proxy 127.0.0.1:{args[0]} {
		transport http {
			keepalive 120s
			keepalive_interval 30s
			max_conns_per_host 100
			dial_timeout 3s
			response_header_timeout 30s
			read_timeout 60s
			write_timeout 60s
		}
	}
}

asepharyana.my.id, www.asepharyana.my.id, asepharyana.web.id, www.asepharyana.web.id, hub.asepharyana.my.id {
	import proxy 4003
}

dashboard.asepharyana.my.id {
	import proxy 4013
}

imphnen.asepharyana.my.id {
	import proxy 4009
}

gmw.asepharyana.my.id {
	import proxy 4009
}

scraper.asepharyana.my.id, api.asepharyana.my.id, scraper.asepharyana.web.id, api.asepharyana.web.id {
	import proxy 4091
}

9router.asepharyana.my.id {
	# LLM streaming: 9router combo models punya TTFT sampe 30-40s (deepseek,
	# fallback chain). Default (proxy) response_header_timeout 30s / read 60s
	# bikin false-positive 504 walau 9router masih ngolah. Longgarkan khusus
	# biar health-check & request PR-Agent real gak kena timeout transient.
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options "nosniff"
	}
	reverse_proxy 127.0.0.1:4014 {
		transport http {
			dial_timeout 3s
			response_header_timeout 120s
			read_timeout 300s
			write_timeout 300s
		}
	}
}

pr-agent.asepharyana.my.id {
	import proxy 4023
}

lidm.asepharyana.my.id {
	import proxy 4004
}

lidm-api.asepharyana.my.id {
	import proxy 4005
}

zeavisedu.asepharyana.my.id {
	import proxy 4011
}

api-zeavisedu.asepharyana.my.id {
	import proxy 4006
}

ml-zeavisedu.asepharyana.my.id {
	import proxy 4012
}

upload.asepharyana.my.id, upload.asepharyana.web.id {
	# Upload/download besar: JANGAN kompres, JANGAN limit body, flush instan (no buffering)
	header {
		-Server
		X-Content-Type-Options "nosniff"
	}
	request_body {
		max_size 0
	}
	reverse_proxy 127.0.0.1:4000 {
		transport http {
			dial_timeout 3s
			read_timeout 300s
			write_timeout 300s
		}
		flush_interval -1
	}
}

wiki.asepharyana.my.id {
	import proxy 4016

	# Phase 7: observability dashboard (public).
	handle /dashboard {
		reverse_proxy 127.0.0.1:4020
	}
	# Phase 7: Prometheus metrics (public, safe to scrape).
	handle /metrics {
		reverse_proxy 127.0.0.1:4020
	}
	# Phase 4: tRPC API (search, revisions, job status, restore). Routed to the
	# API app on :4020 so /trpc/* is reachable on the domain, not swallowed by web.
	# Forward the full /trpc path (no prefix strip) to match app.all("/trpc/*").
	handle /trpc/* {
		reverse_proxy 127.0.0.1:4020
	}
	# Phase 3 git-sync webhook: GitHub POSTs push events here -> BullMQ reindex.
	# Forward the full /hooks path (no prefix strip) to match the API's /hooks/reindex route.
	handle /hooks/* {
		reverse_proxy 127.0.0.1:4020
	}
	handle /health {
		reverse_proxy 127.0.0.1:4020
	}
}
mcpedia.asepharyana.my.id {
	import proxy 4016

	# Alias mcpedia -> wiki (same app): observability/trpc/hooks/health routes.
	handle /dashboard {
		reverse_proxy 127.0.0.1:4020
	}
	handle /metrics {
		reverse_proxy 127.0.0.1:4020
	}
	handle /trpc/* {
		reverse_proxy 127.0.0.1:4020
	}
	handle /hooks/* {
		reverse_proxy 127.0.0.1:4020
	}
	handle /health {
		reverse_proxy 127.0.0.1:4020
	}
}

mcp.asepharyana.my.id {
	import proxy 4021
}
hamc.asepharyana.my.id {
	import proxy 4024
}

dev.asepharyana.my.id {
	import proxy 3000
}

# Hindsight — password-only gate via forward_auth, dashboard + API behind it.
# Mirrors hindsight.imrnes.team: /login form (no username), 30-day sha256 cookie.
#   :8891 hindsight-gate   (systemd) — password gate, cookie auth
#   :9999 hindsight-ui     (systemd) — Next.js control-plane, extracted from Docker image
#   :8890 hindsight        (systemd) — the API itself
#
# forward_auth carries an explicit `not path` matcher on purpose: the directive
# expands into a catch-all handle block, and handle blocks are mutually exclusive.
# A bare forward_auth plus a separate `handle /login` leaves /login unreachable —
# the catch-all wins and 302s to /login forever.
hindsight.asepharyana.my.id {
	encode zstd gzip
	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	@gate_paths path /login /logout
	handle @gate_paths {
		reverse_proxy 127.0.0.1:8891
	}

	@protected not path /login /logout
	forward_auth @protected 127.0.0.1:8891 {
		uri /verify
		copy_headers Authorization Cookie
	}

	# /health is what uptime checks hit; the dashboard has no such route, so it
	# must go to the API explicitly or every monitor reports the site as down.
	handle /health {
		reverse_proxy 127.0.0.1:8890
	}

	# The dashboard is the landing page; the API answers under /v1.
	handle {
		reverse_proxy 127.0.0.1:9999 {
			transport http {
				keepalive 120s
				max_conns_per_host 100
				dial_timeout 3s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	handle /v1/* {
		reverse_proxy 127.0.0.1:8890 {
			transport http {
				keepalive 120s
				max_conns_per_host 100
				dial_timeout 3s
				response_header_timeout 30s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}
}
